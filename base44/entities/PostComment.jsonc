{
  "name": "PostComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "The ID of the community post this comment belongs to"
    },
    "comment": {
      "type": "string",
      "description": "The content of the comment"
    }
  },
  "required": [
    "post_id",
    "comment"
  ],
  "rls": {
    "read": {},
    "write": {
      "created_by": "{{user.email}}"
    }
  }
}